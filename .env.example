# Copiá este archivo como .env y completalo. .env NO se sube a GitHub.
# En Vercel, cargá las mismas variables en Settings → Environment Variables (proyecto del admin).

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Supabase → Project Settings → API Keys → service_role / secret. Es secreta: nunca en el HTML.
SUPABASE_SERVICE_ROLE_KEY=

# Mails que pueden dar de alta socios desde el admin, separados por coma.
ADMIN_EMAILS=

# Adónde lleva el link de la invitación (la app de socios).
APP_URL=http://localhost:4321/prototipo/
